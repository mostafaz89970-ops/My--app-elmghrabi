{
  "name": "unified-counter-system",
  "version": "1.0.0",
  "description": "المنظومة الموحدة لادارة العدادات",
  "main": "main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron --js-flags=\"--max-old-space-size=8192\" .",
    "dist": "npm run build && electron-builder",
    "watch": "tsc --watch",
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "author": "Moustafa Elmaghrabi",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "knex": "^3.1.0",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.elmaghrabi.unifiedcountersystem",
    "productName": "المنظومة الموحدة للعدادات",
    "directories": {
      "output": "${env.USERPROFILE}/Desktop/Unified Counter System Output"
    },
      "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "المنظومة الموحدة للعدادات.html",
      "index.html",
      "index.css",
      "splash.html",
      "cardReader.js",
      "nativeCardEngine.js",
      "internalCardServer.js",
      "debts_store.json",
      "card_store.json",
      "read_card.ps1",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "your-repo-name"
    }
  }
}
